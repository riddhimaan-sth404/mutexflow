PORT=3001
BIND_ADDR=127.0.0.1
BACKEND_URL=http://localhost:3001

# Orchestral runtime (required to enable managed runtime startup)
# Generate a long random value locally; keep it private and do not commit .env.
ORCHESTRAL_ADMIN_KEY=
ORCHESTRAL_JWT_SECRET=
ORCHESTRAL_AUTOSTART=true
ORCHESTRAL_CORE_URL=http://127.0.0.1:8088
ORCHESTRAL_WORKER_URL=http://127.0.0.1:8090
# Optional path to a prebuilt Citadel executable; otherwise Cargo builds/runs it.
ORCHESTRAL_CORE_BIN=
# Optional Python executable override (defaults to python on Windows, python3 elsewhere).
PYTHON=

# Local API protection (recommended)
# Token the desktop app must send as X-MutexFlow-Token on orchestral/JCode
# endpoints. When unset, the backend generates one and persists it owner-only
# at .mutexflow/backend-token.
MUTEXFLOW_API_TOKEN=
# Separate restricted token issued to the local analysis worker. When unset,
# the backend generates one at startup; the worker never sees the admin key.
MUTEXFLOW_WORKER_TOKEN=

# JCode high-concurrency agent runtime (optional; disabled by default)
# Install a compatible JCode build and set its executable path explicitly.
# The backend launches it with a clean environment and a dedicated state directory.
JCODE_AUTOSTART=false
JCODE_BINARY=
# Windows only: path to the companion bridge built from the pinned JCode revision.
JCODE_API_BRIDGE_BINARY=
# Optional JCode provider/model. If omitted, provider is inferred from the first
# configured key in this order: OpenAI, Anthropic, OpenRouter, Gemini.
JCODE_PROVIDER=
JCODE_MODEL=
# Keys are provisioned through JCode's SDK into its owner-only credential store.
JCODE_OPENAI_API_KEY=
JCODE_ANTHROPIC_API_KEY=
JCODE_OPENROUTER_API_KEY=
JCODE_GEMINI_API_KEY=

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# AI Cascades
CEREBRAS_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
SAMBANOVA_API_KEY=
SILICONFLOW_API_KEY=
DEEPSEEK_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
NOVITA_API_KEY=
HF_API_KEY=

# Integrations
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_CHANNEL=#general

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_TARGET_REPO=mutexflow/agent-results

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_SHEET_ID=
