{
  "name": "b2b-ai-desktop",
  "version": "1.0.0",
  "description": "B2B SaaS Electron desktop client for AI agent",
  "private": true,
  "main": "src/main.js",
  "scripts": {
    "start": "electron src/main.js",
    "inject-env": "node src/scripts/inject-env.js",
    "build:win": "node src/scripts/inject-env.js && electron-builder --win",
    "build:mac": "node src/scripts/inject-env.js && electron-builder --mac",
    "build:linux": "node src/scripts/inject-env.js && electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.b2b.ai-agent",
    "productName": "B2B AI Agent",
    "files": [
      "src/**/*"
    ],
    "win": {
      "target": "portable"
    },
    "mac": {
      "target": "dir"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "dependencies": {
    "@nangohq/frontend": "^0.70.4",
    "node-machine-id": "^1.1.7"
  }
}
