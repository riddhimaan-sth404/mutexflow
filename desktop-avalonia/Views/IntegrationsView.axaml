<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MutexFlow.Desktop.ViewModels"
             xmlns:m="clr-namespace:MutexFlow.Desktop.Models"
             x:Class="MutexFlow.Desktop.Views.IntegrationsView"
             x:DataType="vm:IntegrationsViewModel">

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="16" Margin="24">

      <!-- Header & Search -->
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Grid.Column="0">
          <TextBlock Text="Connected Apps" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextMain}" />
          <TextBlock Text="Connect your own tools directly using your Client ID, Bot Tokens, or Webhooks." FontSize="13" Foreground="{StaticResource TextMuted}" />
        </StackPanel>
        <TextBox Grid.Column="1" Text="{Binding SearchQuery}" Width="240" Watermark="Search apps..." VerticalAlignment="Center" />
      </Grid>

      <!-- Apps Grid -->
      <ItemsControl ItemsSource="{Binding FilteredIntegrations}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="m:IntegrationItem">
            <Border Background="{StaticResource CardBg}"
                    BorderBrush="{StaticResource BorderDark}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="14"
                    Margin="0,0,12,12"
                    Width="360">
              <StackPanel Spacing="10">

                <!-- Header Row -->
                <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                  <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" Margin="0,0,8,0" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextMain}" />
                    <TextBlock Text="{Binding Category}" FontSize="11" Foreground="{StaticResource TextMuted}" />
                  </StackPanel>
                  <Border Grid.Column="2"
                          Background="{StaticResource SidebarBg}"
                          CornerRadius="4"
                          Padding="6,2"
                          Margin="6,0"
                          VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusText}" FontSize="10" FontWeight="SemiBold" />
                  </Border>
                  <Button Grid.Column="3"
                          Classes="secondary"
                          Content="Configure"
                          Command="{Binding $parent[UserControl].((vm:IntegrationsViewModel)DataContext).ToggleConfigureCommand}"
                          CommandParameter="{Binding}" />
                </Grid>

                <!-- Description -->
                <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" />

                <!-- In-Card Configuration Drawer -->
                <Border Background="{StaticResource SidebarBg}"
                        BorderBrush="{StaticResource BorderDark}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12"
                        IsVisible="{Binding IsConfiguring}">
                  <StackPanel Spacing="8">
                    
                    <TextBlock Text="Your Client ID / Credentials" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentPurple}" />
                    
                    <!-- Token / Key -->
                    <StackPanel Spacing="2">
                      <TextBlock Text="API Key / Token / Webhook" FontSize="10" Foreground="{StaticResource TextMuted}" />
                      <TextBox Text="{Binding ApiKeyOrToken}" Watermark="{Binding CredentialPlaceholder}" PasswordChar="●" />
                    </StackPanel>

                    <!-- Destination / Target -->
                    <StackPanel Spacing="2">
                      <TextBlock Text="Target (Channel / Repo / ID)" FontSize="10" Foreground="{StaticResource TextMuted}" />
                      <TextBox Text="{Binding TargetDestination}" Watermark="{Binding TargetPlaceholder}" />
                    </StackPanel>

                    <!-- Client ID (optional) -->
                    <StackPanel Spacing="2">
                      <TextBlock Text="Client ID (if using OAuth)" FontSize="10" Foreground="{StaticResource TextMuted}" />
                      <TextBox Text="{Binding ClientId}" Watermark="Your App Client ID..." />
                    </StackPanel>

                    <!-- Save & Test Buttons -->
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                      <Button Classes="primary"
                              Content="Save &amp; Connect"
                              Command="{Binding $parent[UserControl].((vm:IntegrationsViewModel)DataContext).SaveIntegrationCredentialsCommand}"
                              CommandParameter="{Binding}" />
                      <Button Classes="secondary"
                              Content="OAuth Connect"
                              Command="{Binding $parent[UserControl].((vm:IntegrationsViewModel)DataContext).ConnectOAuthCommand}"
                              CommandParameter="{Binding}" />
                    </StackPanel>

                  </StackPanel>
                </Border>

              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

    </StackPanel>
  </ScrollViewer>

</UserControl>
