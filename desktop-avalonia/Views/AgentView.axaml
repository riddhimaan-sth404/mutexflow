<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MutexFlow.Desktop.ViewModels"
             xmlns:m="clr-namespace:MutexFlow.Desktop.Models"
             x:Class="MutexFlow.Desktop.Views.AgentView"
             x:DataType="vm:AgentViewModel">

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="16" Margin="24">

      <!-- Header & Local-First Indicator -->
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Grid.Column="0">
          <TextBlock Text="AI Assistant" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextMain}" />
          <TextBlock Text="Local-First offline inference with user-controlled tool dispatch." FontSize="13" Foreground="{StaticResource TextMuted}" />
        </StackPanel>
        <Border Grid.Column="1"
                Background="{StaticResource CardBg}"
                BorderBrush="{StaticResource BorderDark}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="10,6"
                VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Ellipse Width="8" Height="8" Fill="{StaticResource StatusSuccess}" VerticalAlignment="Center" />
            <TextBlock Text="Local Engine Ready" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource StatusSuccess}" VerticalAlignment="Center" />
          </StackPanel>
        </Border>
      </Grid>

      <!-- Controls Grid -->
      <WrapPanel Orientation="Horizontal">

        <!-- Inference Mode -->
        <StackPanel Width="180" Margin="0,0,12,12" Spacing="4">
          <TextBlock Text="Inference Engine" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" />
          <ComboBox ItemsSource="{Binding AvailableModes}"
                    SelectedItem="{Binding SelectedMode}"
                    HorizontalAlignment="Stretch" />
        </StackPanel>

        <!-- Workflow Type -->
        <StackPanel Width="220" Margin="0,0,12,12" Spacing="4">
          <TextBlock Text="Workflow Action" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" />
          <ComboBox ItemsSource="{Binding AvailableWorkflows}"
                    SelectedItem="{Binding SelectedWorkflow}"
                    HorizontalAlignment="Stretch" />
        </StackPanel>

        <!-- Task Complexity -->
        <StackPanel Width="160" Margin="0,0,12,12" Spacing="4">
          <TextBlock Text="Effort Level" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" />
          <ComboBox ItemsSource="{Binding AvailableComplexities}"
                    SelectedItem="{Binding SelectedComplexity}"
                    HorizontalAlignment="Stretch" />
        </StackPanel>

        <!-- License Key (Only when in Standard Cloud mode) -->
        <StackPanel Width="220" Margin="0,0,12,12" Spacing="4" IsVisible="{Binding !IsByokVisible}">
          <TextBlock Text="Optional License Key" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" />
          <TextBox Text="{Binding LicenseKey}" Watermark="e.g. ABCD-1234-..." />
        </StackPanel>

        <!-- BYOK Key (Only when in BYOK mode) -->
        <StackPanel Width="220" Margin="0,0,12,12" Spacing="4" IsVisible="{Binding IsByokVisible}">
          <TextBlock Text="OpenRouter API Key" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" />
          <TextBox Text="{Binding ByokKey}" PasswordChar="●" Watermark="sk-or-v1-..." />
        </StackPanel>

      </WrapPanel>

      <!-- Prompt Input -->
      <StackPanel Spacing="6">
        <TextBlock Text="Prompt &amp; Instructions" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" />
        <TextBox Text="{Binding PromptText}"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 MinHeight="100"
                 Watermark="Tell the AI assistant what to do (e.g. extract data, draft message, analyze log)..." />
      </StackPanel>

      <!-- Actions -->
      <StackPanel Orientation="Horizontal" Spacing="12">
        <Button Classes="primary"
                Command="{Binding ExecuteAgentCommand}"
                Content="{Binding CooldownButtonText}"
                IsEnabled="{Binding !IsCooldownActive}" />
        <ProgressBar IsIndeterminate="True"
                     IsVisible="{Binding IsExecuting}"
                     Width="120"
                     Height="4"
                     VerticalAlignment="Center" />
      </StackPanel>

      <!-- Output Section -->
      <StackPanel Spacing="8">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0" Text="Execution Log &amp; Output" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" />
          <Button Grid.Column="1" Classes="secondary" Command="{Binding ClearLogsCommand}" Content="Clear log" />
        </Grid>

        <Border Background="{StaticResource SidebarBg}"
                BorderBrush="{StaticResource BorderDark}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12"
                MinHeight="220">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Logs}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="m:LogEntry">
                  <TextBlock Text="{Binding Text}"
                             FontFamily="Consolas, Fira Code, monospace"
                             FontSize="12"
                             Margin="0,2"
                             TextWrapping="Wrap" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Border>
      </StackPanel>

    </StackPanel>
  </ScrollViewer>

</UserControl>
