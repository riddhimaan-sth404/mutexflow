<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MutexFlow.Desktop.ViewModels"
             xmlns:m="clr-namespace:MutexFlow.Desktop.Models"
             x:Class="MutexFlow.Desktop.Views.OrchestralView"
             x:DataType="vm:OrchestralViewModel">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="18" Margin="24">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="4">
          <TextBlock Text="Orchestral Runtime" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextMain}" />
          <TextBlock Text="Agent execution, approvals, local analysis and audit history." FontSize="13" Foreground="{StaticResource TextMuted}" />
        </StackPanel>
        <Button Grid.Column="1" Classes="secondary" Command="{Binding RefreshCommand}" Content="Refresh" VerticalAlignment="Center" />
      </Grid>

      <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="8" Padding="14">
        <StackPanel Spacing="8">
          <TextBlock Text="{Binding RuntimeStatusMessage}" TextWrapping="Wrap" Foreground="{StaticResource TextMain}" />
          <StackPanel Orientation="Horizontal" Spacing="18">
            <TextBlock Text="{Binding CoreHealthy, StringFormat='Citadel healthy: {0}'}" FontSize="12" Foreground="{StaticResource TextMuted}" />
            <TextBlock Text="{Binding WorkerHealthy, StringFormat='Local worker healthy: {0}'}" FontSize="12" Foreground="{StaticResource TextMuted}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="8" Padding="14">
        <StackPanel Spacing="10">
          <TextBlock Text="Passive local workspace analysis" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextMain}" />
          <TextBlock Text="Scans source/config files for possible hard-coded secrets. Only masked evidence is stored. The worker is restricted to the configured MutexFlow workspace root; it does not run network probes or shell commands." TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextMuted}" />
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
            <TextBox Text="{Binding Workspace}" Watermark="Relative workspace path, e.g. backend-rust" />
            <Button Grid.Column="1" Classes="primary" Command="{Binding StartLocalAnalysisCommand}" IsEnabled="{Binding !IsBusy}" Content="Run local scan" />
          </Grid>
          <TextBlock Text="{Binding JobStatusMessage}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextMuted}" />
        </StackPanel>
      </Border>

      <StackPanel Spacing="8">
        <TextBlock Text="Pending approvals" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextMain}" />
        <ItemsControl ItemsSource="{Binding PendingApprovals}">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="m:OrchestralApproval">
              <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                <StackPanel Spacing="6">
                  <TextBlock Text="{Binding ToolName}" FontWeight="SemiBold" Foreground="{StaticResource TextMain}" />
                  <TextBlock Text="{Binding Target}" FontSize="12" Foreground="{StaticResource TextMuted}" />
                  <TextBlock Text="{Binding CommandPreview}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextMuted}" />
                  <TextBlock Text="{Binding RiskTier, StringFormat='Risk: {0}'}" FontSize="12" Foreground="{StaticResource TextMuted}" />
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Classes="primary" Content="Approve" Command="{Binding $parent[UserControl].DataContext.ApproveCommand}" CommandParameter="{Binding}" />
                    <Button Classes="secondary" Content="Deny" Command="{Binding $parent[UserControl].DataContext.DenyCommand}" CommandParameter="{Binding}" />
                  </StackPanel>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <StackPanel Spacing="8">
        <TextBlock Text="Agents" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextMain}" />
        <ItemsControl ItemsSource="{Binding Agents}">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="m:OrchestralAgent">
              <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,6">
                <StackPanel Spacing="3">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource TextMain}" />
                  <TextBlock Text="{Binding Role}" FontSize="12" Foreground="{StaticResource TextMuted}" />
                  <TextBlock Text="{Binding Status}" FontSize="12" Foreground="{StaticResource TextMuted}" />
                  <TextBlock Text="{Binding CurrentTask}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextMuted}" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <StackPanel Spacing="8">
        <TextBlock Text="Findings" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextMain}" />
        <ItemsControl ItemsSource="{Binding Findings}">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="m:OrchestralFinding">
              <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,6">
                <StackPanel Spacing="3">
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{StaticResource TextMain}" />
                  <TextBlock Text="{Binding Severity}" FontSize="12" Foreground="{StaticResource TextMuted}" />
                  <TextBlock Text="{Binding Target}" FontSize="12" Foreground="{StaticResource TextMuted}" />
                  <TextBlock Text="{Binding Description}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextMuted}" />
                  <TextBlock Text="{Binding Evidence}" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource TextMuted}" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <StackPanel Spacing="8">
        <TextBlock Text="Recent audit events" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextMain}" />
        <ItemsControl ItemsSource="{Binding AuditEntries}">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="m:OrchestralAuditEntry">
              <Border Background="{StaticResource SidebarBg}" CornerRadius="4" Padding="8" Margin="0,0,0,4">
                <StackPanel Spacing="2">
                  <TextBlock Text="{Binding Action}" FontWeight="SemiBold" Foreground="{StaticResource TextMain}" />
                  <TextBlock Text="{Binding Details}" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource TextMuted}" />
                  <TextBlock Text="{Binding Timestamp}" FontSize="10" Foreground="{StaticResource TextMuted}" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
